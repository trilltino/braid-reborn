# Cargo build artifacts and generated audit reports
target/

# Keep the workspace lockfile and the isolated fuzz-tooling lockfile
**/Cargo.lock
!/Cargo.lock
!/tests/fuzz/Cargo.lock
/tests/fuzz/target/
/tests/fuzz/artifacts/
/tests/fuzz/corpus/

# Local application data (BRAID_ROOT defaults to braid_data)
braid_data/

# Environment files
.env
.env.*
!.env.example

# Tool caches
__pycache__/
*.py[cod]
node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Zencoder / Zenflow
.zencoder/
.zenflow/

# Gemini
.gemini/
